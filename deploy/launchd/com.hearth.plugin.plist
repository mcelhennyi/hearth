<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template plist for Hearth plugins on macOS.
  Copy to /Library/LaunchDaemons/com.hearth.plugin.<slug>.plist and
  replace SLUG with the plugin slug and PORT with the assigned port.
  Then: sudo launchctl load /Library/LaunchDaemons/com.hearth.plugin.<slug>.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hearth.plugin.SLUG</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/hearth/venv/bin/python</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>SLUG.app:create_app</string>
        <string>--factory</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>PORT</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/hearth/apps/SLUG</string>

    <key>UserName</key>
    <string>hearth</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HEARTH_VAR_DIR</key>
        <string>/var/hearth</string>
        <key>HEARTH_PLUGIN_SLUG</key>
        <string>SLUG</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/var/hearth/log/hearth-plugin-SLUG.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/var/hearth/log/hearth-plugin-SLUG.stderr.log</string>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
