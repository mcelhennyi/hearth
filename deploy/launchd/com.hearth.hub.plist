<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hearth.hub</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/hearth/venv/bin/uvicorn</string>
        <string>app.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8200</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/hearth</string>

    <key>UserName</key>
    <string>hearth</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HEARTH_VAR_DIR</key>
        <string>/var/hearth</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/var/hearth/log/hearth-hub.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/var/hearth/log/hearth-hub.stderr.log</string>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
