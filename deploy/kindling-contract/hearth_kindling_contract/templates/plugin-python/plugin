#!/usr/bin/env python3
"""Per-plugin admin shim generated by the Kindling plugin template."""

from __future__ import annotations

import sys
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent


def main() -> int:
    try:
        from hearth_plugin_cli.cli import PluginCliError, run_plugin_cli
    except ImportError:
        print(
            "plugin: hearth_plugin_cli is unavailable; install the hearth-ops package.",
            file=sys.stderr,
        )
        return 1
    try:
        return run_plugin_cli(PLUGIN_ROOT, sys.argv[1:])
    except PluginCliError as exc:
        print(f"plugin: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
