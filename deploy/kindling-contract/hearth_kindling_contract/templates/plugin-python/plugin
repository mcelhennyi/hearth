#!/usr/bin/env python3
"""Per-plugin admin shim generated by the Kindling plugin template."""

from __future__ import annotations

import runpy
import sys

PLUGIN_SLUG = "{{ plugin_slug }}"
ADMIN_MODULE = "{{ python_package }}.admin"
COMMON_FLAGS = {
    "--update",
    "--remove",
    "--enable",
    "--disable",
    "--start",
    "--stop",
    "--reset",
    "--status",
    "--logs",
    "--doctor",
}


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help", "help"}:
        print(
            f"{PLUGIN_SLUG} plugin admin\n"
            "\n"
            "Common flags: --update --remove --enable --disable --start --stop --reset --exit\n"
            "Extras:       --status --logs --doctor\n"
            "Passthrough:  plugin -- <admin args>"
        )
        return 0

    if args[0] == "--":
        return _run_admin(args[1:])

    if args[0] == "--exit":
        try:
            from hearth_install.plugin_session import (
                PluginEnterSessionError,
                exit_plugin_enter_session,
            )
        except ImportError as exc:
            print(f"{PLUGIN_SLUG}: hearth_install is not importable: {exc}", file=sys.stderr)
            return 1
        try:
            exit_plugin_enter_session()
            return 0
        except PluginEnterSessionError as exc:
            print(f"{PLUGIN_SLUG}: {exc}", file=sys.stderr)
            return 1

    if args[0] in COMMON_FLAGS:
        print(f"{PLUGIN_SLUG}: {args[0]} handled by template stub")
        return 0

    return _run_admin(args)


def _run_admin(args: list[str]) -> int:
    sys.argv = [ADMIN_MODULE, *args]
    runpy.run_module(ADMIN_MODULE, run_name="__main__")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
