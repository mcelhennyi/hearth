# Hearth Caddyfile — template for TLS + plugin reverse-proxy.
#
# This file is the base configuration.  The hub API generates a fragment file
# (default: /workspace/var/hearth/caddy-fragment.conf) that is imported below.
# Each enabled plugin gets a reverse-proxy route in the fragment.
#
# To use: copy to /etc/caddy/Caddyfile inside the caddy container and ensure
# the fragment volume is mounted at the path below.

hearth.home.arpa {
  tls internal

  # Plugin reverse-proxy routes — generated by hub on install/enable/disable.
  # The fragment file is written to HEARTH_CADDY_FRAGMENT_PATH by proxy.caddy.
  import /workspace/var/hearth/caddy-fragment.conf

  # Hub API
  handle /api/* {
    reverse_proxy hub:8200
  }

  # SPA shell (Mantle)
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
