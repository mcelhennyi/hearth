hearth.home.arpa {
  tls internal
  handle /api/* {
    reverse_proxy hub:8200
  }
  handle_path /hearth-users/* {
    reverse_proxy hearth-users:8000
  }
  import Caddyfile.plugins
  handle {
    root * /srv
    # SPA: /dashboard etc. are client routes — serve index.html when no static file exists.
    try_files {path} /index.html
    file_server
  }
}
