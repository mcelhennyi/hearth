{
  "name": "@kindling/mantle",
  "version": "0.1.0",
  "description": "Mantle UI primitives, hooks, tokens, and vanilla bridge for Hearth plugins.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/tokens.css",
    "src/components.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": "./src/tokens.css",
    "./styles.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./vanilla/mantle.iife": "./dist/vanilla/mantle.iife.js",
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && pnpm run build && vitest run",
    "pack:dry-run": "pnpm run build && npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.5",
    "typescript": "~6.0.2",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mcelhennyi/hearth.git",
    "directory": "packages/mantle"
  }
}
