#!/usr/bin/env python3
"""Run the in-tree Hearth CLI without requiring package installation."""

from __future__ import annotations

import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
for rel in ("deploy/hearth-cli", "deploy/hearth-install"):
    sys.path.insert(0, str(REPO_ROOT / rel))

from hearth_cli.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
