#!/usr/bin/env bash
# Local development entrypoint for FR-0002 Caddy TLS prototype.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

if [[ -f "$REPO_ROOT/develop.conf" ]]; then
  # shellcheck source=/dev/null
  source "$REPO_ROOT/develop.conf"
fi

: "${DEVELOP_LABEL:=$(basename "$REPO_ROOT")}"
: "${DEVELOP_COMPOSE_FILE:=deploy/compose/docker-compose.yml}"

compose_abs() { echo "$REPO_ROOT/$DEVELOP_COMPOSE_FILE"; }

require_docker() {
  command -v docker >/dev/null 2>&1 || { echo "develop: docker not found on PATH" >&2; exit 1; }
}

require_compose_file() {
  [[ -f "$(compose_abs)" ]] || { echo "develop: missing $(compose_abs) (set DEVELOP_COMPOSE_FILE or add a compose file)." >&2; exit 1; }
}

compose() {
  require_docker
  require_compose_file
  (cd "$REPO_ROOT" && docker compose -f "$DEVELOP_COMPOSE_FILE" "$@")
}

usage() {
  cat <<USAGE
${DEVELOP_LABEL} — FR-0002 local stack

Usage: $(basename "$0") <command> [arguments]

Commands
  help, -h, --help  Show this message.
  up [args]         Start the local Caddy stack (pass -d for background).
  down [args]       Stop the local Caddy stack.
  ca-export         Serve local CA cert at :8080/ca.crt for <= 10 minutes.
  ps                Show Compose service status.
USAGE
}

cmd_up() { compose up "$@"; }

cmd_down() {
  if [[ ! -f "$(compose_abs)" ]]; then
    echo "develop: no ${DEVELOP_COMPOSE_FILE} at $(compose_abs); nothing to stop."
    exit 0
  fi
  compose down "$@"
}

cmd_ca_export() { compose up --abort-on-container-exit --exit-code-from ca-export ca-export; }

main() {
  local cmd="${1:-}"
  [[ -n "$cmd" ]] || { usage; exit 0; }
  case "$cmd" in
    -h|--help|help) usage ;;
    up) shift; cmd_up "$@" ;;
    down) shift; cmd_down "$@" ;;
    ca-export) shift; cmd_ca_export "$@" ;;
    ps) shift; compose ps "$@" ;;
    *) echo "develop: unknown command: $cmd" >&2; echo "Try: $(basename "$0") help" >&2; exit 1 ;;
  esac
}

main "$@"
