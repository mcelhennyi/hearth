#!/usr/bin/env bash
# Local development entrypoint (FR-0002 PWA prototype + main dev tooling).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

if [[ -f "$REPO_ROOT/develop.conf" ]]; then
  # shellcheck source=/dev/null
  source "$REPO_ROOT/develop.conf"
fi

: "${DEVELOP_LABEL:=$(basename "$REPO_ROOT")}"
: "${DEVELOP_COMPOSE_FILE:=deploy/compose/docker-compose.yml}"
: "${DEVELOP_DOCS_SERVICE:=docs}"
: "${DEVELOP_DOCS_PORT:=5081}"

compose_abs() {
  echo "$REPO_ROOT/$DEVELOP_COMPOSE_FILE"
}

require_docker() {
  command -v docker >/dev/null 2>&1 || {
    echo "develop: docker not found on PATH" >&2
    exit 1
  }
}

require_compose_file() {
  [[ -f "$(compose_abs)" ]] || {
    echo "develop: missing $(compose_abs) (set DEVELOP_COMPOSE_FILE or add a compose file)." >&2
    exit 1
  }
}

compose() {
  require_docker
  require_compose_file
  (cd "$REPO_ROOT" && docker compose -f "$DEVELOP_COMPOSE_FILE" "$@")
}

usage() {
  cat <<USAGE
${DEVELOP_LABEL} — local stack + docs + tests

Usage: $(basename "$0") <command> [arguments]

Commands
  help, -h, --help  Show this message.
  up [args]         Start the local Caddy stack (pass -d for background).
  up-quick [args]   Start HTTP-only static server on :5080 (no TLS; fast iteration).
  docs [args]       Start MkDocs in Docker (bind-mounted repo; live reload). Default URL:
                    http://127.0.0.1:${DEVELOP_DOCS_PORT}/ (set DEVELOP_DOCS_PORT in develop.conf).
  down [args]       Stop Compose services for this project file.
  ca-export         Serve local CA cert at :8080/ca.crt for <= 10 minutes.
  web <args...>     Run web tooling command in Docker (apps/hub/web).
  api <args...>     Run API tooling command in Docker (apps/hub/api).
  vapid-gen         Generate var/hearth/secrets/vapid.{pub,priv} in Docker.
  ps                Show Compose service status.
  test [pytest…]    Run pytest in python:3.12-slim (profile test; needs network for pip).

HTTP quick mode serves the same static tree on port 5080 (plain HTTP, any Host),
e.g. http://127.0.0.1:5080/ or, with /etc/hosts, http://hearth.local:5080/.
MkDocs Material runs beside it on port ${DEVELOP_DOCS_PORT} via ./develop docs.
For TLS + PWA testing, use up (https://hearth.home.arpa/ on :443).
USAGE
}

cmd_up() {
  compose up "$@"
}

cmd_up_quick() {
  compose up "$@" caddy-http
}

cmd_docs() {
  export HEARTH_DOCS_PORT="${DEVELOP_DOCS_PORT}"
  compose --profile docs up "$@" "$DEVELOP_DOCS_SERVICE"
}

cmd_down() {
  if [[ ! -f "$(compose_abs)" ]]; then
    echo "develop: no ${DEVELOP_COMPOSE_FILE} at $(compose_abs); nothing to stop."
    exit 0
  fi
  compose down "$@"
}

cmd_ca_export() {
  compose up --abort-on-container-exit --exit-code-from ca-export ca-export
}

cmd_web() {
  [[ "$#" -gt 0 ]] || { echo "develop: web command requires arguments (example: ./develop web npm run test)." >&2; exit 1; }
  compose run --rm --no-deps web "$@"
}

cmd_api() {
  [[ "$#" -gt 0 ]] || { echo "develop: api command requires arguments (example: ./develop api pytest)." >&2; exit 1; }
  compose run --rm --no-deps -e PYTHONPATH=/app hub "$@"
}

cmd_vapid_gen() {
  compose run --rm --no-deps -e PYTHONPATH=/app hub python /workspace/scripts/gen-vapid.py
}

cmd_test() {
  compose --profile test run --rm hearth-test "$@"
}

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then
    usage
    exit 0
  fi

  case "$cmd" in
    -h|--help|help)
      usage
      ;;
    up)
      shift
      cmd_up "$@"
      ;;
    up-quick)
      shift
      cmd_up_quick "$@"
      ;;
    docs)
      shift
      cmd_docs "$@"
      ;;
    down)
      shift
      cmd_down "$@"
      ;;
    ca-export)
      shift
      cmd_ca_export "$@"
      ;;
    web)
      shift
      cmd_web "$@"
      ;;
    api)
      shift
      cmd_api "$@"
      ;;
    vapid-gen)
      shift
      cmd_vapid_gen "$@"
      ;;
    ps)
      shift
      compose ps "$@"
      ;;
    test)
      shift
      cmd_test "$@"
      ;;
    *)
      echo "develop: unknown command: $cmd" >&2
      echo "Try: $(basename "$0") help" >&2
      exit 1
      ;;
  esac
}

main "$@"
